# Gateway (LAN IP for phone/emulator — not localhost)
EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:4000

# Required — Google Maps only (no Expo / OSM fallback).
# Enable: Maps JavaScript API, Maps SDK Android/iOS, Places API, Places API (New),
# Geocoding API, Directions API, Distance Matrix API.
# Restart Expo after changing: npx expo start -c
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ── Firebase Phone Auth (customer login + signup phone OTP) ─────────────
# Firebase Console → Project settings → Your apps → Web app (public keys).
# Enable Authentication → Sign-in method → Phone.
# Restart Expo after changing: npx expo start -c
# Server also needs Firebase Admin in user-service .env:
#   FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY
#   (REGISTER_PHONE_PROVIDER=firebase when Admin keys are set)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=tokajofoods.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=tokajofoods
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=tokajofoods.appspot.com

# Email OTP / forgot-password / welcome mail still use user-service SMTP:
#   SENDER_EMAIL, SENDER_PASSWORD, EMAIL_HOST, EMAIL_PORT
