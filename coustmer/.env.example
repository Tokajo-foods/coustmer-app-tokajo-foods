# Gateway (LAN IP for phone/emulator — not localhost)
EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:4000

# Required — Google Maps only (no Expo / OSM fallback).
# Enable: Maps JavaScript API, Maps SDK Android/iOS, Places API, Places API (New),
# Geocoding API, Directions API, Distance Matrix API.
# Restart Expo after changing: npx expo start -c
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ── Auth OTP (customer) ────────────────────────────────────────────────
# Customer phone/email OTP does NOT use Firebase in this app.
# Do NOT add EXPO_PUBLIC_FIREBASE_* here — those keys are only for the
# restaurant/rider Expo app (Firebase Phone Auth on partner signup).
#
# Wire delivery on user-service instead (root / user-service .env):
#   Email OTP, forgot-password OTP, welcome mail:
#     SENDER_EMAIL, SENDER_PASSWORD, EMAIL_HOST, EMAIL_PORT
#   Phone OTP (login + signup) — SMS path always for customers:
#     TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_CALLER_ID
#     and/or MSG91_AUTH_KEY, MSG91_SENDER_ID
#     and/or NOTIFICATION_SERVICE_URL
#   Firebase Admin (FIREBASE_PROJECT_ID / CLIENT_EMAIL / PRIVATE_KEY) is for
#   partner phone verify only — not required for this customer app.
