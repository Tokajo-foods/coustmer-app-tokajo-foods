# EAS reads only this repo-root file (nested .gitignore rules are skipped on Windows).
# Paths stay anchored to coustmer/ so coustmer/modules/*/android (local native code) is still uploaded.
# .env (EXPO_PUBLIC_* only) and google-services.json are uploaded on purpose; eas.json env wins over .env.

.git
node_modules/
.idea/
.cursor/

coustmer/android/
coustmer/ios/
coustmer/builds/
coustmer/dist/
coustmer/web-build/
coustmer/.expo/
coustmer/.expo-tmp-android/
coustmer/.expo-android-test/
coustmer/.kotlin/
coustmer/satoshi.zip
coustmer/expo-env.d.ts

*.apk
*.aab
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision
*.orig.*
*.bak*
*.tsbuildinfo
.env*.local
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
